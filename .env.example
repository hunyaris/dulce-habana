# =====================================================
# DULCE HABANA - Variables de entorno
# =====================================================
# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas .env a git (ya está en .gitignore).

# === BASE DE DATOS (Requerido) ===
# En desarrollo local puedes usar SQLite:
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# En producción (Vercel) usa PostgreSQL de Supabase o Neon:
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROYECTO.supabase.co:5432/postgres"
# o
# DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# === SUPABASE (Opcional - para futuro Auth OAuth y Storage de imágenes) ===
# Crea un proyecto en https://supabase.com y copia estas valores
# NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJxxx..."

# === SITIO ===
# URL pública del sitio (Vercel la asigna automáticamente)
# NEXT_PUBLIC_SITE_URL="https://dulce-habana.vercel.app"
